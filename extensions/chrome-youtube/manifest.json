{
  "manifest_version": 3,
  "name": "Fabu YouTube 助手",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "仅按需向本机 Fabu 提供 YouTube 登录态，无需手动导出 Cookie。",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fabu YouTube 助手"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
